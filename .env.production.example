# ============================================================================
# HackTepa — PRODUCTION env template. Copy to .env on the server, fill secrets.
# Never commit the filled-in file. Anything marked >>> MUST be set <<<.
# ============================================================================

APP_NAME=HackTepa
APP_ENV=production
APP_DEBUG=false                       # NEVER true in prod — leaks stack traces, env, APP_KEY
APP_URL=https://hacktepa.com          # real https origin; drives signed URLs + cookies

# >>> MUST be set <<<  run: php artisan key:generate  (encrypts cookies/sessions)
APP_KEY=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

BCRYPT_ROUNDS=12

# Quiet logs in prod; ship errors to Sentry instead of disk-debug.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database — private network only, no public port, strong unique password ---
# Host is 127.0.0.1 for a single-box deploy (Postgres on the droplet). "pgsql"
# only resolves inside Docker/Sail. Use the private VPC IP if PG is on another host.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hacktepa
DB_USERNAME=hacktepa
DB_PASSWORD=            # >>> MUST be set <<<  long random, not "password"

# --- Sessions ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120              # 2h, not 30 days — shrinks hijack window
SESSION_ENCRYPT=true             # encrypt session payload at rest in redis
SESSION_PATH=/
SESSION_DOMAIN=hacktepa.com
SESSION_SECURE_COOKIE=true       # cookies only over HTTPS
SESSION_SAME_SITE=lax            # CSRF defense-in-depth

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Redis — set a password + enable AUTH; no public port ---
# 127.0.0.1 for a single-box deploy. "redis" only resolves inside Docker/Sail.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=          # >>> MUST be set <<<  must match requirepass in /etc/redis/redis.conf
REDIS_PORT=6379

# --- Mail (Resend) ---
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="hello@hacktepa.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=          # >>> MUST be set <<< for email verification + password reset

# --- Object storage (Hetzner S3) — both challenge files and writeup images ---
AWS_ACCESS_KEY_ID=       # >>> MUST be set <<<
AWS_SECRET_ACCESS_KEY=   # >>> MUST be set <<<
AWS_DEFAULT_REGION=fsn1
AWS_BUCKET=hacktepa
AWS_ENDPOINT=https://fsn1.your-objectstorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# Challenge files live on private S3 (served via short-lived signed URLs).
CHALLENGES_DISK_DRIVER=s3
CHALLENGES_S3_BUCKET=hacktepa-challenges
CHALLENGES_S3_PREFIX=challenges

# Writeup inline images on S3 in prod (not the local 'public' disk).
WRITEUP_IMAGE_DISK=s3

# --- hCaptcha — REQUIRED, or signup captcha is silently disabled ---
HCAPTCHA_SITEKEY=        # >>> MUST be set <<<
HCAPTCHA_SECRET=         # >>> MUST be set <<<

# --- Sentry (error visibility) ---
SENTRY_LARAVEL_DSN=      # recommended
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Plausible analytics ---
PLAUSIBLE_DOMAIN=hacktepa.com
PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# --- Dynamic flag HMAC secret ---
# >>> MUST be set <<<  distinct from APP_KEY. run: php -r "echo bin2hex(random_bytes(32));"
# Empty here falls back to APP_KEY (FlagGenerator), coupling flag integrity to the
# cookie key and breaking all dynamic flags if APP_KEY is ever rotated.
FLAG_SECRET=

# Abuse thresholds (tune after launch).
SUSPICIOUS_HARD_SOLVES=5
SUSPICIOUS_WINDOW_MINUTES=5
